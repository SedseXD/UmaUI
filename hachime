            TextBox.PlaceholderText = placeholder or "Type here..."
            TextBox.Text = ""
            TextBox.Font = Enum.Font.Gotham
            TextBox.TextSize = 12
            TextBox.TextColor3 = Color3.fromRGB(0, 0, 0)
            TextBox.ZIndex = 4
            TextBox.Parent = TBFrame

            local TxtCorner = Instance.new("UICorner")
            TxtCorner.CornerRadius = UDim.new(0, 4)
            TxtCorner.Parent = TextBox

            TextBox.FocusLost:Connect(function() if callback then callback(TextBox.Text) end end)
        end

        function Elements:CreateDropdown(dropName, options, callback)
            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, 0, 0, 35)
            DropFrame.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
            DropFrame.ClipsDescendants = true
            DropFrame.ZIndex = 3
            DropFrame.Parent = TabPage

            local DropCorner = Instance.new("UICorner")
            DropCorner.CornerRadius = UDim.new(0, 6)
            DropCorner.Parent = DropFrame

            local DropBtn = Instance.new("TextButton")
            DropBtn.Size = UDim2.new(1, 0, 0, 35)
            DropBtn.BackgroundTransparency = 1
            DropBtn.Text = dropName .. " (Click to Expand)"
            DropBtn.Font = Enum.Font.GothamSemibold
            DropBtn.TextSize = 14
            DropBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
            DropBtn.ZIndex = 4
            DropBtn.Parent = DropFrame

            local DropList = Instance.new("UIListLayout")
            DropList.SortOrder = Enum.SortOrder.LayoutOrder
            DropList.Parent = DropFrame

            local isOpen = false
            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                DropFrame.Size = UDim2.new(1, 0, 0, isOpen and (35 + (#options * 30)) or 35)
            end)

            for _, opt in ipairs(options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Size = UDim2.new(1, 0, 0, 30)
                OptBtn.BackgroundColor3 = Color3.fromRGB(235, 235, 235)
                OptBtn.Text = opt
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextSize = 13
                OptBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
                OptBtn.ZIndex = 4
                OptBtn.Parent = DropFrame

                OptBtn.MouseButton1Click:Connect(function()
                    DropBtn.Text = dropName .. " : " .. opt
                    isOpen = false
                    DropFrame.Size = UDim2.new(1, 0, 0, 35)
                    if callback then callback(opt) end
                end)
            end
        end

        return Elements
    end

    return Window
end

return Library
