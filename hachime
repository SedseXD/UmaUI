            BtnCorner.CornerRadius = UDim.new(1, 0)
            BtnCorner.Parent = ToggleBtn

            local Indicator = Instance.new("Frame")
            Indicator.Size = UDim2.new(0, 16, 0, 16)
            Indicator.Position = state and UDim2.new(1, -16, 0, 0) or UDim2.new(0, 0, 0, 0)
            Indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Indicator.ZIndex = 5
            Indicator.Parent = ToggleBtn

            local IndCorner = Instance.new("UICorner")
            IndCorner.CornerRadius = UDim.new(1, 0)
            IndCorner.Parent = Indicator

            ToggleBtn.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = state and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 200, 200)}):Play()
                TweenService:Create(Indicator, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -16, 0, 0) or UDim2.new(0, 0, 0, 0)}):Play()
                if callback then callback(state) end
            end)
        end

        function Elements:CreateTextbox(tbName, placeholder, callback)
            local TBFrame = Instance.new("Frame")
            TBFrame.Size = UDim2.new(1, 0, 0, 35)
            TBFrame.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
            TBFrame.ZIndex = 3
            TBFrame.Parent = TabPage

            local TBCorner = Instance.new("UICorner")
            TBCorner.CornerRadius = UDim.new(0, 6)
            TBCorner.Parent = TBFrame

            local TBLabel = Instance.new("TextLabel")
            TBLabel.Size = UDim2.new(0.5, 0, 1, 0)
            TBLabel.Position = UDim2.new(0, 10, 0, 0)
            TBLabel.BackgroundTransparency = 1
            TBLabel.Text = tbName
            TBLabel.Font = Enum.Font.GothamSemibold
            TBLabel.TextSize = 14
            TBLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
            TBLabel.TextXAlignment = Enum.TextXAlignment.Left
            TBLabel.ZIndex = 4
            TBLabel.Parent = TBFrame

            local TextBox = Instance.new("TextBox")
            TextBox.Size = UDim2.new(0.5, -20, 0, 25)
            TextBox.Position = UDim2.new(0.5, 10, 0.5, -12.5)
